# ==============================================================================
# AGROTECH ENTERPRISE — O SISTEMA OPERACIONAL DA EMPRESA RURAL
# Arquivo de Configuração de Ambiente (.env)
# ==============================================================================

# --- AMBIENTE E REDE ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SECONDARY_PORT=5173

# --- SEGURANÇA E AUTENTICAÇÃO JWT ---
# Gere uma chave segura aleatória com: openssl rand -hex 32
JWT_SECRET=super_agrotech_enterprise_jwt_secret_change_me_in_production_2026
JWT_EXPIRATION=7d
CORS_ORIGIN=*

# --- BANCO DE DADOS & PERSISTÊNCIA ---
# Modo de Armazenamento: STANDALONE_LOCAL (ACID Atômico Embutido) ou POSTGRESQL
STORAGE_ENGINE=STANDALONE_LOCAL
# Caso utilize PostgreSQL / PostGIS (ex: via Docker Compose ou Cloud RDS):
# DATABASE_URL=postgres://agro_admin:agro_secure_password_2026@localhost:5432/super_agtech_db
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_MINUTES=60

# --- FISCAL SEFAZ & CERTIFICADO DIGITAL A1 ---
# Ambiente SEFAZ: 1 = Produção Oficial | 2 = Homologação / Testes
SEFAZ_AMBIENTE=2
SEFAZ_UF=MT
SEFAZ_CERTIFICADO_PATH=./data/certificados/certificado_a1.pfx
SEFAZ_CERTIFICADO_SENHA=sua_senha_do_certificado
SEFAZ_CSC_ID=000001
SEFAZ_CSC_TOKEN=SEU_CODIGO_DE_SEGURANCA_CSC_SEFAZ

# --- MENSAGERIA & TELEMETRIA IoT ---
# Configurações de alertas automáticos WhatsApp / SMS / Telegram
ALERTA_WHATSAPP_ENABLED=false
ALERTA_WHATSAPP_API_URL=https://api.gateway-agro.com/v1/send
ALERTA_WHATSAPP_TOKEN=seu_token_aqui
TELEMETRIA_BUFFER_MAX_RECORDS=50000
TELEMETRIA_SSE_HEARTBEAT_SECONDS=15

# --- SATÉLITE & SENSORIAMENTO REMOTO ---
# Provedor padrão: COPERNICUS_SENTINEL_2 ou PLANET_NICFI
SATELITE_PROVEDOR=COPERNICUS_SENTINEL_2
SATELITE_API_KEY=copernicus_open_hub_key_optional

# --- GATEWAY DE PAGAMENTOS SAAS BILLING ---
# Suporte a Asaas, Stripe, Mercado Pago ou BACEN Pix Direto
BILLING_GATEWAY=BACEN_PIX_DIRETO
BILLING_PIX_CHAVE=financeiro@suaempresarural.com.br
BILLING_WEBHOOK_SECRET=whsec_agrotech_pix_notification_secret
